# Template for the .env file. Copy this to .env and fill in real values.
#   cp .env.example .env
# .env is git-ignored; this template is committed to document required vars.

# Sentry DSN (Project Settings -> Client Keys). Leave blank to disable Sentry.
SENTRY_DSN=

# Django runtime configuration.
# Generate a unique, unpredictable SECRET_KEY for every production environment.
SECRET_KEY=
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Django 3.0 accepts host names. The settings module also accepts and normalizes
# a complete Render origin such as https://oc-lettings.onrender.com.
CSRF_TRUSTED_ORIGINS=
